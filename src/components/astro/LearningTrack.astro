---
import TrackCard from "./TrackCard.astro";

const tracks = [
    {
        image: "/research-track-artwork.svg",
        imageAlt: "Research and discovery pathway illustration",
        eyebrow: "Explore the why",
        title: "Research & discovery",
        description:
            "Ask better questions, understand people, and turn insight into a clear problem worth solving.",
        topics: "Problem framing · User research · Product thinking",
        tone: "blue" as const,
    },
    {
        image: "/design-track-artwork.svg",
        imageAlt: "Design and creativity pathway illustration",
        eyebrow: "Make it meaningful",
        title: "Design & creativity",
        description:
            "Translate ideas into thoughtful experiences, from a first sketch to a prototype people can use.",
        topics: "UI/UX · Visual storytelling · Prototyping",
        tone: "yellow" as const,
    },
    {
        image: "/development-track-artwork.svg",
        imageAlt: "Development pathway illustration",
        eyebrow: "Bring ideas to life",
        title: "Development",
        description:
            "Learn the tools, write the code, and build useful things with people who enjoy figuring it out.",
        topics: "Web & mobile · Cloud · AI foundations",
        tone: "green" as const,
    },
];
---

<section id="learning-tracks" class="scroll-mt-24">
    <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-20 lg:px-12">
        <div class="max-w-3xl">
            <p class="inline-flex items-center gap-2 rounded-full text-sm text-[#5F6368] uppercase">
                <span
                    class="size-2 rounded-full bg-[#1967D2]"
                    aria-hidden="true"
                ></span>
                Explore your interests
            </p>
            <h2 class="mt-4 text-4xl leading-tight font-bold tracking-[-0.035em] text-[#242424] sm:text-5xl">
                Three ways in. Plenty of ways forward.
            </h2>
            <p class="mt-5 text-base leading-7 text-[#5F6368] sm:text-lg sm:leading-8">
                These pathways are starting points, not boxes. Follow one deeply
                or bring different skills together.
            </p>
        </div>

        <div class="mt-10 grid items-stretch gap-5 md:grid-cols-3 lg:gap-6">
            {tracks.map((track) => (
                <TrackCard {...track} />
            ))}
        </div>
    </div>
</section>
