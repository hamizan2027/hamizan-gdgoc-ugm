<section id="contact" class="px-5 pb-20 sm:px-8 sm:pb-24 lg:px-12">
    <div class="mx-auto max-w-7xl overflow-hidden rounded-[2rem] bg-[#EAF2FF] px-6 py-12 sm:px-10 sm:py-16 lg:px-16">
        <div class="grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
            <div class="max-w-2xl">
                <p class="inline-flex items-center gap-2 rounded-full text-sm text-[#5F6368] uppercase">
                    <span
                        class="size-2 rounded-full bg-[#1967D2]"
                        aria-hidden="true"
                    ></span>
                    Your next chapter
                </p>
                <h2 class="mt-4 text-4xl leading-tight font-bold tracking-[-0.035em] text-[#242424] sm:text-5xl">
                    Bring your curiosity.
                    <br />
                    We’ll build from there.
                </h2>
                <p class="mt-5 max-w-xl text-base leading-7 text-[#5F6368]">
                    Find a learning track, meet a collaborator, or start a
                    conversation.
                </p>
            </div>
            <div class="flex flex-col gap-3 sm:flex-row md:flex-col">
                <a
                    href="/overview"
                    class="inline-flex min-h-12 items-center justify-center rounded-full bg-[#1967D2] px-6 text-sm font-semibold text-white transition-colors hover:bg-[#1558B0]"
                >
                    Explore the overview
                </a>
                <a
                    href="https://www.instagram.com/gdgoc.ugm/"
                    target="_blank"
                    rel="noreferrer"
                    class="inline-flex min-h-12 items-center justify-center rounded-full border border-[#1967D2]/30 px-6 text-sm font-semibold text-[#1967D2] transition-colors hover:bg-white/70"
                >
                    Talk to the community
                </a>
            </div>
        </div>
    </div>
</section>
