---
const steps = [
    {
        number: "01",
        title: "Follow your curiosity",
        description:
            "Explore the tracks and find a topic you want to understand better.",
    },
    {
        number: "02",
        title: "Learn alongside others",
        description:
            "Join a learning opportunity, ask a question, and share your perspective.",
    },
    {
        number: "03",
        title: "Turn learning into action",
        description:
            "Practice through a project, exchange feedback, and pass something on.",
    },
];
---

<section class="bg-[#F8F9FA]">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-24 lg:px-12">
        <div class="max-w-2xl">
            <p class="inline-flex items-center gap-2 rounded-full text-sm text-[#5F6368] uppercase">
                <span
                    class="size-2 rounded-full bg-[#1967D2]"
                    aria-hidden="true"
                ></span>
                Make your first move
            </p>
            <h2 class="mt-4 text-4xl leading-tight font-bold tracking-[-0.035em] text-[#242424] sm:text-5xl">
                You don’t need to have it all figured out.
            </h2>
        </div>
        <ol class="mt-10 grid gap-11 md:grid-cols-3">
            {steps.map((step) => (
                <li>
                    <p
                        class={`text-[44px] font-bold tracking-tight text-[#1967D2]`}
                    >
                        {step.number}
                    </p>
                    <div class="my-6 h-px bg-[#DADCE0]" />
                    <h3 class="text-xl font-bold text-[#242424]">
                        {step.title}
                    </h3>
                    <p class="mt-3 text-sm leading-6 text-[#5F6368]">
                        {step.description}
                    </p>
                </li>
            ))}
        </ol>
    </div>
</section>
