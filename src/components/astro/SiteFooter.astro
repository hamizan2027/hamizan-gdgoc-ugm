---
import ResponsiveLogo from "../react/ResponsiveLogo";

const exploreLinks = [
    { href: "/home", label: "Home" },
    { href: "/overview", label: "Overview" },
];
---

<footer class="bg-[#F1F3F4]">
    <div class="mx-auto max-w-7xl px-5 py-12 sm:px-8 lg:px-12">
        <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.5fr_0.7fr_0.8fr]">
            <div class="max-w-md">
                <ResponsiveLogo client:load />

                <p class="mt-4 text-sm leading-6 text-[#5F6368]">
                    A student community for curious minds, shared learning, and
                    technology with purpose.
                </p>
            </div>
            <div>
                <h2 class="text-sm font-bold text-[#242424]">Explore</h2>
                <ul class="mt-4 space-y-3">
                    {exploreLinks.map((link) => (
                        <li>
                            <a
                                href={link.href}
                                class="text-sm text-[#5F6368] hover:text-[#1967D2]"
                            >
                                {link.label}
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
            <div>
                <h2 class="text-sm font-bold text-[#242424]">
                    Keep in the loop
                </h2>
                <a
                    href="https://www.instagram.com/gdgoc.ugm/"
                    target="_blank"
                    rel="noreferrer"
                    class="mt-4 inline-block text-sm font-semibold text-[#1967D2] hover:underline"
                >
                    @gdgoc.ugm
                </a>
                <p class="mt-3 text-sm text-[#5F6368]">
                    Learn together. Build together.
                </p>
            </div>
        </div>

        <div class="mt-10 flex flex-col gap-3 border-t border-[#DADCE0] pt-6 text-xs text-[#5F6368] sm:flex-row sm:items-center sm:justify-between">
            <p>© GDGoC Universitas Gadjah Mada · 2026/2027</p>
            <p>Made for the campus. Open to possibilities.</p>
        </div>
        <div
            class="mt-7 flex h-1 overflow-hidden rounded-full"
            aria-hidden="true"
        >
            <span class="w-1/4 bg-[#4284F4]"></span>
            <span class="w-1/4 bg-[#EA4335]"></span>
            <span class="w-1/4 bg-[#F9AB00]"></span>
            <span class="w-1/4 bg-[#34A853]"></span>
        </div>
    </div>
</footer>
