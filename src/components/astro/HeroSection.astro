---
---

<section
    id="top"
    class="mx-auto grid w-full max-w-7xl items-center gap-12 px-5 py-16 sm:px-8 sm:py-20 lg:grid-cols-2 lg:gap-16 lg:px-12 lg:py-24"
>
    <div class="max-w-2xl">
        <p class="mb-6 inline-flex items-center gap-2 rounded-full text-sm text-[#5F6368] uppercase">
            <span
                class="size-2 rounded-full bg-[#1967D2]"
                aria-hidden="true"
            ></span>
            GDGoC UGM <span aria-hidden="true">·</span> 2026/2027
        </p>
        <h1 class="text-5xl leading-[1.05] font-bold tracking-[-0.045em] text-[#242424] sm:text-6xl lg:text-7xl">
            Big ideas.
            <br />
            <span class="text-[#1967D2]">Built together.</span>
        </h1>
        <p class="mt-7 max-w-xl text-lg leading-8 text-[#5F6368]">
            A place for curious minds at{" "}
            <span class="font-semibold text-[#242424]">
                Universitas Gadjah Mada
            </span>
            &nbsp;to learn, connect, and build technology that matters.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-[#1967D2] px-6 text-sm font-semibold text-white transition-colors hover:bg-[#1558B0] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1967D2]">
                Find your learning track <span aria-hidden="true">→</span>
            </a>
            <a class="inline-flex min-h-12 items-center justify-center rounded-full border border-[#DADCE0] px-6 text-sm font-semibold text-[#242424] transition-colors hover:bg-[#F8F9FA]">
                Get to know us
            </a>
        </div>
        <div class="mt-10 flex items-center gap-4">
            <div class="flex -space-x-1" aria-hidden="true">
                <span class="size-3 rounded-full border-2 border-white bg-[#4284F4]"></span>
                <span class="size-3 rounded-full border-2 border-white bg-[#EA4335]"></span>
                <span class="size-3 rounded-full border-2 border-white bg-[#F9AB00]"></span>
                <span class="size-3 rounded-full border-2 border-white bg-[#34A853]"></span>
            </div>
            <p class="text-sm text-[#5F6368]">
                Different backgrounds. A shared curiosity.
            </p>
        </div>
    </div>

    <div class="relative mx-auto w-full max-w-xl">
        <div class="absolute -left-4 top-12 size-40 rounded-full bg-[#EAF2FF] sm:-left-8 sm:size-40 blur-xl"></div>
        <div class="absolute -right-2 bottom-10 size-44 rounded-full bg-[#FFF7DF] sm:-right-6 sm:size-48 blur-xl"></div>
        <div class="relative rounded-[2rem] bg-[#F8F9FA]">
            <img src="/glass-tile-artwork.png" />
        </div>
    </div>
</section>
