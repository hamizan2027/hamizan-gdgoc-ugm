---
const promises = [
    "Learn by doing",
    "Connect across disciplines",
    "Build with purpose",
];
---

<section
    aria-label="Our community promise"
    class="border-y border-[#DADCE0] bg-white"
>
    <div class="mx-auto grid max-w-7xl gap-5 px-5 py-7 sm:grid-cols-3 sm:px-8 lg:px-12">
        {promises.map((promise, index) => (
            <div class="flex items-center gap-3 sm:justify-center lg:justify-start">
                <span
                    class:list={[
                        "flex size-8 shrink-0 items-center justify-center rounded-full text-sm font-bold",
                        index === 0 && "text-[#1967D2]",
                        index === 1 && "text-[#C5221F]",
                        index === 2 && "text-[#188038]",
                    ]}
                    aria-hidden="true"
                >
                    ■
                </span>
                <p class="font-semibold text-[#242424]">{promise}</p>
            </div>
        ))}
    </div>
</section>
