<section id="starting-point" class="scroll-mt-24 bg-[#FFF7DF] mb-24">
    <div class="mx-auto grid max-w-7xl gap-8 px-5 py-14 sm:px-8 sm:py-16 md:grid-cols-[0.9fr_1.1fr] md:items-center md:gap-12 lg:px-12 lg:gap-16">
        <div>
            <p class="text-sm font-bold tracking-[0.14em] text-[#5F6368] uppercase">
                Start where you are
            </p>
            <h2 class="mt-4 text-4xl leading-tight font-bold tracking-[-0.035em] text-[#242424] sm:text-5xl">
                New to tech?
                <br />
                That’s a starting point, too.
            </h2>
        </div>
        <div class="max-w-2xl">
            <p class="text-base leading-7 text-[#5F6368] sm:text-lg sm:leading-8">
