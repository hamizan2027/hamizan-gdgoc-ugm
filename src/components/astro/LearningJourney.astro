---
const stages = [
    {
        number: "01",
        title: "Discover",
        description:
            "Explore a topic and find the questions you want to answer.",
    },
    {
        number: "02",
        title: "Practice",
        description:
            "Try an exercise, work through a challenge, and ask for help.",
    },
    {
        number: "03",
        title: "Build",
        description:
            "Apply your learning to a small idea with a clear purpose.",
    },
    {
        number: "04",
        title: "Share",
        description:
            "Show your process, gather feedback, and help someone else.",
    },
];
---

<section id="learning-journey" class="scroll-mt-24 bg-[#F8F9FA]">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-24 lg:px-12">
        <div class="max-w-2xl">
            <p class="inline-flex items-center gap-2 rounded-full text-sm text-[#5F6368] uppercase">
                <span
                    class="size-2 rounded-full bg-[#1967D2]"
                    aria-hidden="true"
                ></span>
                Progress, not perfection
            </p>
            <h2 class="mt-4 text-4xl leading-tight font-bold tracking-[-0.035em] text-[#242424] sm:text-5xl">
                A journey you can keep building on.
            </h2>
        </div>

        <ol class="mt-10 grid gap-11 sm:grid-cols-2 lg:grid-cols-4">
            {stages.map((stage) => (
                <li>
                    <p class="text-[44px] font-bold tracking-tight text-[#1967D2]">
                        {stage.number}
                    </p>
                    <div class="my-6 h-px bg-[#DADCE0]" />
                    <h3 class="text-xl font-bold text-[#242424]">
                        {stage.title}
                    </h3>
                    <p class="mt-3 text-sm leading-6 text-[#5F6368]">
                        {stage.description}
                    </p>
                </li>
            ))}
        </ol>
    </div>
</section>
