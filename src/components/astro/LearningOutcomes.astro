---
const outcomes = [
    {
        pathway: "Research & discovery",
        practice: "Listening, problem framing, and testing assumptions",
        outcome: "A research insight and a focused problem brief",
    },
    {
        pathway: "Design & creativity",
        practice: "Ideation, user flows, and prototype feedback",
        outcome: "An interactive prototype and a design story",
    },
    {
        pathway: "Development",
        practice: "Coding, testing, and connecting tools",
        outcome: "A working demo with a clear explanation",
    },
];
---

<section class="w-full">
    <div class="mx-auto max-w-7xl px-5 pb-16 sm:px-8 sm:pb-20 lg:px-12">
        <h2 class="mb-7 text-2xl leading-tight font-bold tracking-tight text-[#242424] sm:text-3xl">
            From an interest to something you can show.
        </h2>

        <div class="overflow-hidden rounded-2xl border border-[#DADCE0]">
            <div class="hidden grid-cols-[0.8fr_1.2fr_1.2fr] gap-6 bg-[#F1F3F4] px-7 py-5 text-sm font-semibold text-[#5F6368] md:grid">
                <p>Pathway</p>
                <p>What you can practice</p>
                <p>A possible outcome</p>
            </div>

            <div class="divide-y divide-[#DADCE0]">
                {outcomes.map((row) => (
                    <article class="grid gap-4 px-5 py-5 sm:px-7 md:grid-cols-[0.8fr_1.2fr_1.2fr] md:items-center md:gap-6">
                        <h3 class="flex items-center gap-3 text-base font-semibold text-[#242424]">
                            {row.pathway}
                        </h3>
                        <div>
                            <p class="mb-1 text-xs font-semibold tracking-wide text-[#757575] uppercase md:hidden">
                                What you can practice
                            </p>
                            <p class="text-sm leading-6 text-[#5F6368]">
                                {row.practice}
                            </p>
                        </div>
                        <div>
                            <p class="mb-1 text-xs font-semibold tracking-wide text-[#757575] uppercase md:hidden">
                                A possible outcome
                            </p>
                            <p class="text-sm leading-6 text-[#5F6368] md:text-[#242424]">
                                {row.outcome}
                            </p>
                        </div>
                    </article>
                ))}
            </div>
        </div>

        <p class="mt-4 text-xs leading-5 text-[#757575]">
            Illustrative learning outcomes. Topics and opportunities are shared
            through community updates.
        </p>
    </div>
</section>
