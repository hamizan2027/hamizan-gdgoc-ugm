---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import SiteNavigation from "../components/react/SiteNavigation";

export interface Props {
    title?: string;
    description?: string;
    image?: string;
}

const {
    title = "Hamizan Ihkamuddin Raharjo - Google Developer Group on Campus UGM",
    description = "Google Developer Group on Campus UGM is a student organization that focuses on technology and software development, providing opportunities for students to learn, collaborate, and innovate in the field of technology.",
} = Astro.props;

const canonicalURL = new URL(
    Astro.url.pathname,
    Astro.site || "https://gdgoc-ugm.pages.dev.com",
);

const currentPath = Astro.url.pathname;
---

<html lang="id" class="h-full scrollbar scroll-smooth antialiased text-justify">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />

        <title>{title} | GDGoC UGM</title>
        <meta name="title" content={title} />
        <meta name="description" content={description} />
        <meta
            name="keywords"
            content="Google Developer Group, Google Developer Group on Campus UGM, GDG UGM, GDGoC UGM, GDGoC, GDG, Google Developer Group on Campus, Google Developer Group on Campus UGM,"
        />
        <meta name="author" content="Hamizan Ihkamuddin Raharjo" />
        <meta name="robots" content="index, follow" />

        <link rel="canonical" href={canonicalURL} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:site_name" content="Hamizan | GDGoC UGM" />

        <ClientRouter />
    </head>

    <body class="flex flex-col min-h-screen w-full overflow-x-hidden bg-white font-google-sans scroll-smooth antialiased">
        <!-- Navbar -->
        <SiteNavigation currentPath={currentPath} client:load />

        <!-- Content -->
        <div>
            <div>
                <main class="flex-1 flex flex-col w-full relative">
                    <slot />
                </main>
            </div>
        </div>
    </body>
</html>
